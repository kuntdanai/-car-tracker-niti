// Prisma schema for Car Tracker Niti — fleet trip & fuel report app

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum DataSource {
  MOCK
  CARTRACK
  MANUAL
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  name         String
  role         Role        @default(STAFF)
  createdAt    DateTime    @default(now())
  fuelEntries  FuelEntry[]
}

model Vehicle {
  id          String      @id @default(cuid())
  name        String
  plateNumber String      @unique
  cartrackId  String?     @unique
  fuelType    String?
  createdAt   DateTime    @default(now())
  trips       Trip[]
  fuelEntries FuelEntry[]
}

model Trip {
  id              String     @id @default(cuid())
  vehicleId       String
  vehicle         Vehicle    @relation(fields: [vehicleId], references: [id])
  externalTripId  String?    @unique
  source          DataSource @default(MOCK)
  legs            TripLeg[]
  startedAt       DateTime
  endedAt         DateTime
  totalDistanceKm Float
  drivingMinutes  Int
  idleMinutes     Int
  rawPayload      Json?
  createdAt       DateTime   @default(now())

  @@index([vehicleId, startedAt])
}

model TripLeg {
  id             String   @id @default(cuid())
  tripId         String
  trip           Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  sequence       Int
  fromLabel      String
  fromLat        Float
  fromLng        Float
  toLabel        String
  toLat          Float
  toLng          Float
  startedAt      DateTime
  endedAt        DateTime
  distanceKm     Float
  drivingMinutes Int
  idleMinutes    Int

  @@index([tripId])
}

model FuelEntry {
  id           String   @id @default(cuid())
  vehicleId    String
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id])
  date         DateTime
  liters       Float
  amountPaid   Float
  odometerKm   Float?
  enteredById  String
  enteredBy    User     @relation(fields: [enteredById], references: [id])
  createdAt    DateTime @default(now())

  @@index([vehicleId, date])
}
